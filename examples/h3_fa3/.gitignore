# Generated videos and old one-off runs stay out of git history.
*.mp4
/bullettime_nvfp4_30st_seed42.mp4
/outputs_old/
/outputs

# Plots are regenerated by calibration/analyze_*.py.  Keep the two summary
# figures referenced by the calibration README; the 3D/heatmap/histogram
# panels are reproducible artifacts.
*.png
/calibration/plots/**/*.png
!/calibration/plots/20261116_fl2va_prompt/layer_group_relL2.png
!/calibration/plots/20261116_fl2va_prompt/layer_sensitivity_by_group.png

# The top-level .gitignore drops every CSV; keep the per-prompt analysis
# tables that back results.md.
*.csv
!/calibration/plots/20261116_fl2va_prompt/*.csv
